{"ast":null,"code":"export default {\n  data: () => ({\n    ecosystem: [{\n      text: 'vuetify-loader',\n      href: 'https://github.com/vuetifyjs/vuetify-loader'\n    }, {\n      text: 'github',\n      href: 'https://github.com/vuetifyjs/vuetify'\n    }, {\n      text: 'awesome-vuetify',\n      href: 'https://github.com/vuetifyjs/awesome-vuetify'\n    }],\n    importantLinks: [{\n      text: 'Documentation',\n      href: 'https://vuetifyjs.com'\n    }, {\n      text: 'Chat',\n      href: 'https://community.vuetifyjs.com'\n    }, {\n      text: 'Made with Vuetify',\n      href: 'https://madewithvuetifyjs.com'\n    }, {\n      text: 'Twitter',\n      href: 'https://twitter.com/vuetifyjs'\n    }, {\n      text: 'Articles',\n      href: 'https://medium.com/vuetify'\n    }],\n    whatsNext: [{\n      text: 'Explore components',\n      href: 'https://vuetifyjs.com/components/api-explorer'\n    }, {\n      text: 'Select a layout',\n      href: 'https://vuetifyjs.com/layout/pre-defined'\n    }, {\n      text: 'Frequently Asked Questions',\n      href: 'https://vuetifyjs.com/getting-started/frequently-asked-questions'\n    }]\n  })\n};","map":{"version":3,"names":["data","ecosystem","text","href","importantLinks","whatsNext"],"sources":["src/components/HelloWorld.vue"],"sourcesContent":["<template>\n  <v-container>\n    <v-layout\n      text-xs-center\n      wrap\n    >\n      <v-flex xs12>\n        <v-img\n          :src=\"require('../assets/logo.svg')\"\n          class=\"my-3\"\n          contain\n          height=\"200\"\n        ></v-img>\n      </v-flex>\n\n      <v-flex mb-4>\n        <h1 class=\"display-2 font-weight-bold mb-3\">\n          Welcome to Vuetify\n        </h1>\n        <p class=\"subheading font-weight-regular\">\n          For help and collaboration with other Vuetify developers,\n          <br>please join our online\n          <a href=\"https://community.vuetifyjs.com\" target=\"_blank\">Discord Community</a>\n        </p>\n      </v-flex>\n\n      <v-flex\n        mb-5\n        xs12\n      >\n        <h2 class=\"headline font-weight-bold mb-3\">What's next?</h2>\n\n        <v-layout justify-center>\n          <a\n            v-for=\"(next, i) in whatsNext\"\n            :key=\"i\"\n            :href=\"next.href\"\n            class=\"subheading mx-3\"\n            target=\"_blank\"\n          >\n            {{ next.text }}\n          </a>\n        </v-layout>\n      </v-flex>\n\n      <v-flex\n        xs12\n        mb-5\n      >\n        <h2 class=\"headline font-weight-bold mb-3\">Important Links</h2>\n\n        <v-layout justify-center>\n          <a\n            v-for=\"(link, i) in importantLinks\"\n            :key=\"i\"\n            :href=\"link.href\"\n            class=\"subheading mx-3\"\n            target=\"_blank\"\n          >\n            {{ link.text }}\n          </a>\n        </v-layout>\n      </v-flex>\n\n      <v-flex\n        xs12\n        mb-5\n      >\n        <h2 class=\"headline font-weight-bold mb-3\">Ecosystem</h2>\n\n        <v-layout justify-center>\n          <a\n            v-for=\"(eco, i) in ecosystem\"\n            :key=\"i\"\n            :href=\"eco.href\"\n            class=\"subheading mx-3\"\n            target=\"_blank\"\n          >\n            {{ eco.text }}\n          </a>\n        </v-layout>\n      </v-flex>\n    </v-layout>\n  </v-container>\n</template>\n\n<script>\n  export default {\n    data: () => ({\n      ecosystem: [\n        {\n          text: 'vuetify-loader',\n          href: 'https://github.com/vuetifyjs/vuetify-loader'\n        },\n        {\n          text: 'github',\n          href: 'https://github.com/vuetifyjs/vuetify'\n        },\n        {\n          text: 'awesome-vuetify',\n          href: 'https://github.com/vuetifyjs/awesome-vuetify'\n        }\n      ],\n      importantLinks: [\n        {\n          text: 'Documentation',\n          href: 'https://vuetifyjs.com'\n        },\n        {\n          text: 'Chat',\n          href: 'https://community.vuetifyjs.com'\n        },\n        {\n          text: 'Made with Vuetify',\n          href: 'https://madewithvuetifyjs.com'\n        },\n        {\n          text: 'Twitter',\n          href: 'https://twitter.com/vuetifyjs'\n        },\n        {\n          text: 'Articles',\n          href: 'https://medium.com/vuetify'\n        }\n      ],\n      whatsNext: [\n        {\n          text: 'Explore components',\n          href: 'https://vuetifyjs.com/components/api-explorer'\n        },\n        {\n          text: 'Select a layout',\n          href: 'https://vuetifyjs.com/layout/pre-defined'\n        },\n        {\n          text: 'Frequently Asked Questions',\n          href: 'https://vuetifyjs.com/getting-started/frequently-asked-questions'\n        }\n\n      ]\n    })\n  }\n</script>\n\n<style>\n\n</style>\n"],"mappings":"AAuFA;EACAA,IAAA,EAAAA,CAAA;IACAC,SAAA,GACA;MACAC,IAAA;MACAC,IAAA;IACA,GACA;MACAD,IAAA;MACAC,IAAA;IACA,GACA;MACAD,IAAA;MACAC,IAAA;IACA,EACA;IACAC,cAAA,GACA;MACAF,IAAA;MACAC,IAAA;IACA,GACA;MACAD,IAAA;MACAC,IAAA;IACA,GACA;MACAD,IAAA;MACAC,IAAA;IACA,GACA;MACAD,IAAA;MACAC,IAAA;IACA,GACA;MACAD,IAAA;MACAC,IAAA;IACA,EACA;IACAE,SAAA,GACA;MACAH,IAAA;MACAC,IAAA;IACA,GACA;MACAD,IAAA;MACAC,IAAA;IACA,GACA;MACAD,IAAA;MACAC,IAAA;IACA;EAGA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}