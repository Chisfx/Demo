{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  data: () => ({\n    users: [],\n    dialog: false,\n    dialogDelete: false,\n    headers: [{\n      text: 'ID',\n      value: 'id'\n    }, {\n      text: 'Name',\n      value: 'name'\n    }, {\n      text: 'Email',\n      value: 'email'\n    }, {\n      text: 'Age',\n      value: 'age'\n    }, {\n      text: 'Actions',\n      value: 'actions',\n      sortable: false\n    }],\n    desserts: [],\n    editedIndex: -1,\n    editedItem: {\n      name: '',\n      calories: 0,\n      fat: 0,\n      carbs: 0,\n      protein: 0\n    },\n    defaultItem: {\n      id: 0,\n      name: '',\n      email: '',\n      age: 0\n    }\n  }),\n  computed: {\n    formTitle() {\n      return this.editedIndex === -1 ? 'New User' : 'Edit User';\n    }\n  },\n  watch: {\n    dialog(val) {\n      val || this.close();\n    },\n    dialogDelete(val) {\n      val || this.closeDelete();\n    }\n  },\n  created() {\n    this.userlist();\n  },\n  methods: {\n    userlist() {\n      let me = this;\n      axios.get('api/user/getall').then(function (response) {\n        //console.log(response);\n        me.users = response.data;\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    editItem(item) {\n      this.editedIndex = this.desserts.indexOf(item);\n      this.editedItem = Object.assign({}, item);\n      this.dialog = true;\n    },\n    deleteItem(item) {\n      this.editedIndex = this.desserts.indexOf(item);\n      this.editedItem = Object.assign({}, item);\n      this.dialogDelete = true;\n    },\n    deleteItemConfirm() {\n      this.desserts.splice(this.editedIndex, 1);\n      this.closeDelete();\n    },\n    close() {\n      this.dialog = false;\n      this.$nextTick(() => {\n        this.editedItem = Object.assign({}, this.defaultItem);\n        this.editedIndex = -1;\n      });\n    },\n    closeDelete() {\n      this.dialogDelete = false;\n      this.$nextTick(() => {\n        this.editedItem = Object.assign({}, this.defaultItem);\n        this.editedIndex = -1;\n      });\n    },\n    save() {\n      if (this.editedIndex > -1) {\n        Object.assign(this.desserts[this.editedIndex], this.editedItem);\n      } else {\n        this.desserts.push(this.editedItem);\n      }\n      this.close();\n    }\n  }\n};","map":{"version":3,"names":["axios","data","users","dialog","dialogDelete","headers","text","value","sortable","desserts","editedIndex","editedItem","name","calories","fat","carbs","protein","defaultItem","id","email","age","computed","formTitle","watch","val","close","closeDelete","created","userlist","methods","me","get","then","response","catch","error","console","log","editItem","item","indexOf","Object","assign","deleteItem","deleteItemConfirm","splice","$nextTick","save","push"],"sources":["src/components/User.vue"],"sourcesContent":["<template>\r\n  <v-layout>\r\n    <v-flex>\r\n      <v-data-table\r\n    :headers=\"headers\"\r\n    :items=\"users\"\r\n    sort-by=\"id\"\r\n    class=\"elevation-1\"\r\n  >\r\n    <template v-slot:top>\r\n      <v-toolbar\r\n        flat\r\n      >\r\n        <v-toolbar-title>Users</v-toolbar-title>\r\n        <v-divider\r\n          class=\"mx-4\"\r\n          inset\r\n          vertical\r\n        ></v-divider>\r\n        <v-spacer></v-spacer>\r\n        <v-dialog\r\n          v-model=\"dialog\"\r\n          max-width=\"500px\"\r\n        >\r\n          <template v-slot:activator=\"{ on, attrs }\">\r\n            <v-btn\r\n              color=\"primary\"\r\n              dark\r\n              class=\"mb-2\"\r\n              v-bind=\"attrs\"\r\n              v-on=\"on\"\r\n            >\r\n              New User\r\n            </v-btn>\r\n          </template>\r\n          <v-card>\r\n            <v-card-title>\r\n              <span class=\"text-h5\">{{ formTitle }}</span>\r\n            </v-card-title>\r\n            <v-card-text>\r\n              <v-container>\r\n                <v-row>\r\n                  <v-col\r\n                    cols=\"12\"\r\n                    sm=\"6\"\r\n                    md=\"4\"\r\n                  >\r\n                    <v-text-field\r\n                      v-model=\"editedItem.id\"\r\n                      label=\"ID\"\r\n                    ></v-text-field>\r\n                  </v-col>\r\n                  <v-col\r\n                    cols=\"12\"\r\n                    sm=\"6\"\r\n                    md=\"4\"\r\n                  >\r\n                    <v-text-field\r\n                      v-model=\"editedItem.name\"\r\n                      label=\"Name\"\r\n                    ></v-text-field>\r\n                  </v-col>\r\n                  <v-col\r\n                    cols=\"12\"\r\n                    sm=\"6\"\r\n                    md=\"4\"\r\n                  >\r\n                    <v-text-field\r\n                      v-model=\"editedItem.email\"\r\n                      label=\"Email\"\r\n                    ></v-text-field>\r\n                  </v-col>\r\n                  <v-col\r\n                    cols=\"12\"\r\n                    sm=\"6\"\r\n                    md=\"4\"\r\n                  >\r\n                    <v-text-field\r\n                      v-model=\"editedItem.age\"\r\n                      label=\"Age\"\r\n                    ></v-text-field>\r\n                  </v-col>\r\n                </v-row>\r\n              </v-container>\r\n            </v-card-text>\r\n            <v-card-actions>\r\n              <v-spacer></v-spacer>\r\n              <v-btn\r\n                color=\"blue darken-1\"\r\n                text\r\n                @click=\"close\"\r\n              >\r\n                Cancel\r\n              </v-btn>\r\n              <v-btn\r\n                color=\"blue darken-1\"\r\n                text\r\n                @click=\"save\"\r\n              >\r\n                Save\r\n              </v-btn>\r\n            </v-card-actions>\r\n          </v-card>\r\n        </v-dialog>\r\n        <v-dialog v-model=\"dialogDelete\" max-width=\"500px\">\r\n          <v-card>\r\n            <v-card-title class=\"text-h5\">Are you sure you want to delete this item?</v-card-title>\r\n            <v-card-actions>\r\n              <v-spacer></v-spacer>\r\n              <v-btn color=\"blue darken-1\" text @click=\"closeDelete\">Cancel</v-btn>\r\n              <v-btn color=\"blue darken-1\" text @click=\"deleteItemConfirm\">OK</v-btn>\r\n              <v-spacer></v-spacer>\r\n            </v-card-actions>\r\n          </v-card>\r\n        </v-dialog>\r\n      </v-toolbar>\r\n    </template>\r\n    <template v-slot:item.actions=\"{ item }\">\r\n      <v-icon\r\n        small\r\n        class=\"mr-2\"\r\n        @click=\"editItem(item)\"\r\n      >\r\n        mode\r\n      </v-icon>\r\n      <v-icon\r\n        small\r\n        @click=\"deleteItem(item)\"\r\n      >\r\n        delete\r\n      </v-icon>\r\n    </template>\r\n    <template v-slot:no-data>\r\n      <v-btn\r\n        color=\"primary\"\r\n        @click=\"initialize\"\r\n      >\r\n        Reset\r\n      </v-btn>\r\n    </template>\r\n  </v-data-table>\r\n    </v-flex>\r\n  </v-layout>\r\n\r\n</template>\r\n<script>\r\n  import axios from 'axios'\r\n  export default {\r\n    data: () => ({\r\n      users:[],\r\n      dialog: false,\r\n      dialogDelete: false,\r\n      headers: [\r\n        { text: 'ID', value: 'id' },\r\n        { text: 'Name', value: 'name' },\r\n        { text: 'Email', value: 'email' },\r\n        { text: 'Age', value: 'age' },\r\n        { text: 'Actions', value: 'actions', sortable: false },\r\n      ],\r\n      desserts: [],\r\n      editedIndex: -1,\r\n      editedItem: {\r\n        name: '',\r\n        calories: 0,\r\n        fat: 0,\r\n        carbs: 0,\r\n        protein: 0,\r\n      },\r\n      defaultItem: {\r\n        id: 0,\r\n        name: '',\r\n        email: '',\r\n        age: 0\r\n      },\r\n    }),\r\n\r\n    computed: {\r\n      formTitle () {\r\n        return this.editedIndex === -1 ? 'New User' : 'Edit User'\r\n      },\r\n    },\r\n\r\n    watch: {\r\n      dialog (val) {\r\n        val || this.close()\r\n      },\r\n      dialogDelete (val) {\r\n        val || this.closeDelete()\r\n      },\r\n    },\r\n\r\n    created () {\r\n      this.userlist();\r\n    },\r\n\r\n    methods: {\r\n      userlist () {\r\n        let me = this;\r\n        axios.get('api/user/getall').then(function(response){\r\n          //console.log(response);\r\n          me.users = response.data;\r\n        }).catch(function(error){\r\n          console.log(error);\r\n        });\r\n      },\r\n      editItem (item) {\r\n        this.editedIndex = this.desserts.indexOf(item)\r\n        this.editedItem = Object.assign({}, item)\r\n        this.dialog = true\r\n      },\r\n\r\n      deleteItem (item) {\r\n        this.editedIndex = this.desserts.indexOf(item)\r\n        this.editedItem = Object.assign({}, item)\r\n        this.dialogDelete = true\r\n      },\r\n\r\n      deleteItemConfirm () {\r\n        this.desserts.splice(this.editedIndex, 1)\r\n        this.closeDelete()\r\n      },\r\n\r\n      close () {\r\n        this.dialog = false\r\n        this.$nextTick(() => {\r\n          this.editedItem = Object.assign({}, this.defaultItem)\r\n          this.editedIndex = -1\r\n        })\r\n      },\r\n\r\n      closeDelete () {\r\n        this.dialogDelete = false\r\n        this.$nextTick(() => {\r\n          this.editedItem = Object.assign({}, this.defaultItem)\r\n          this.editedIndex = -1\r\n        })\r\n      },\r\n\r\n      save () {\r\n        if (this.editedIndex > -1) {\r\n          Object.assign(this.desserts[this.editedIndex], this.editedItem)\r\n        } else {\r\n          this.desserts.push(this.editedItem)\r\n        }\r\n        this.close()\r\n      },\r\n    },\r\n  }\r\n</script>"],"mappings":";AAkJA,OAAAA,KAAA;AACA;EACAC,IAAA,EAAAA,CAAA;IACAC,KAAA;IACAC,M